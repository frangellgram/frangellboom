# Hardened nginx config for serving frangellboom's `dist/` build as a static
# site on a VPS. This app has no backend of its own — everything (including
# video processing) runs client-side — so the only attack surface here is
# nginx itself serving static files. Copy this into your server block and
# adjust `server_name` / TLS cert paths.
#
# Usage:
#   1. rsync the built dist/ folder to e.g. /var/www/frangellboom
#   2. Point this server block at that root
#   3. `nginx -t && systemctl reload nginx`

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name your-domain.example;

    ssl_certificate     /etc/letsencrypt/live/your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root /var/www/frangellboom;
    index index.html;

    # Real HTTP headers (a <meta> CSP tag can't set frame-ancestors,
    # X-Frame-Options, or HSTS — those only work as actual response headers).
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

    # ffmpeg-core.wasm needs SharedArrayBuffer-adjacent isolation for some
    # browsers to hand it the fastest code path. Harmless to set even for
    # the single-threaded core this app ships.
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;

    # Long-cache hashed assets, never cache the HTML/manifest/service worker.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
    }

    # Don't serve dotfiles (.env, .git, etc.) if any ever end up in the root.
    location ~ /\. {
        deny all;
    }

    client_max_body_size 1m; # this app never uploads anything to the server
}

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.example;
    return 301 https://$host$request_uri;
}
